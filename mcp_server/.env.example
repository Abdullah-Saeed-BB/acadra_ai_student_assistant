# The combined API app loads these from .env; explicit shell values take priority.
# The standalone mcp-server entry point uses shell values only.
STUDY_MCP_TRANSPORT=streamable-http
STUDY_MCP_HOST=127.0.0.1
STUDY_MCP_PORT=8000
STUDY_MCP_DEBUG=False

STUDY_API_DEBUG=False

# LLMs
GROQ_API_KEY=API_KEY
GROQ_MODEL=openai/gpt-oss-120b

# Google
ACADRA_GMAIL_CLIENT_ID=your_client_id
ACADRA_GMAIL_CLIENT_SECRET=your_client_secret
# Must exactly match the authorized redirect URI in Google Cloud Console.
ACADRA_GMAIL_REDIRECT_URI=http://127.0.0.1:8001/api/connections/gmail/callback
ACADRA_WEB_URL=http://localhost:3000

# PostgreSQL connection for db/db_init.py and manual text storage.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/study_planner
