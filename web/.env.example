# Optional. Base URL of the local Python API used by manual entry, Gmail setup,
# task creation, and the Alexa+ MCP bridge.
MANUAL_SOURCE_API_URL=http://127.0.0.1:8001

# Optional. Streamable HTTP endpoint of the Python study planner MCP server.
# The bridge reads this only on the Next.js server; the browser never sees it.
# Default: http://127.0.0.1:8001/mcp
#
# Port note: this targets the combined REST + MCP app (`uv run api-server`, which
# defaults to port 8001 and mounts /mcp). The standalone MCP entry point
# (`uv run mcp-server --transport streamable-http`) serves the same /mcp path on
# STUDY_MCP_PORT, which defaults to 8000. Match this URL to whichever one you run.
MCP_SERVER_URL=http://127.0.0.1:8000/mcp

# Chat model used by the Alexa+ bridge (lib/mcp-client.ts) to decide which
# study_* MCP tool to call. Same names as the Python backend.
# MODEL_PROVIDER: groq (default) | openai | openrouter | deepseek
MODEL_PROVIDER=groq
MODEL_NAME=openai/gpt-oss-120b
# Set the key matching MODEL_PROVIDER. Missing key -> bridge returns 503 and
# the simulator shows its fallback message.
# GROQ_API_KEY=API_KEY
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# Optional. Chat-completions timeout in milliseconds. Kept separate from the
# 30-second MCP round-trip budget because tool-calling rounds can take longer.
# Default: 60000
LLM_REQUEST_TIMEOUT_MS=60000

# Optional. Retries for transient model failures (network, 408/409/425/429/5xx).
# Non-transient 400/401/403 responses are never retried. Default: 2
MODEL_MAX_RETRIES=2

# Optional. Groq model used as a fallback when a non-Groq primary provider
# fails and GROQ_API_KEY is set. Default: openai/gpt-oss-120b
MODEL_FALLBACK_NAME=openai/gpt-oss-120b
